# Required
DATABASE_URL=postgresql://app_user:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres

# Server-side AES-256-GCM at-rest encryption & authHash HMAC pepper (32-byte base64)
AT_REST_KEY=

# Optional: enables GIF search in the composer (https://developers.giphy.com).
GIPHY_API_KEY=

# Optional: adds "Imgur" as a photo host in Settings
IMGUR_CLIENT_ID=

# Optional: catbox.moe userhash & encrypted upload fallback chain
CATBOX_USERHASH=
UPLOAD_PROVIDERS=catbox,pomf,db

# Optional: Android TWA Digital Asset Links
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINT=
